#   PW=$(openssl rand -hex 24)
#   kubectl -n stock-trading create secret generic postgres-secret \
#     --from-literal=POSTGRES_USER=trading --from-literal=POSTGRES_PASSWORD=$PW \
#     --from-literal=POSTGRES_DB=trading \
#     --from-literal=DATABASE_URL=postgresql://trading:$PW@postgres:5432/trading
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: stock-trading
type: Opaque
stringData:
  POSTGRES_USER: "trading"
  POSTGRES_PASSWORD: "<password>"
  POSTGRES_DB: "trading"
  DATABASE_URL: "postgresql://trading:<password>@postgres:5432/trading"
