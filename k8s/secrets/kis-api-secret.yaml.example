# 예시 파일. 실제 값으로 kis-api-secret.yaml 을 만들거나(커밋 금지, .gitignore 처리됨)
# 아래 kubectl 명령으로 직접 만든다 — 그러면 파일이 남지 않는다.
#
#   kubectl -n stock-trading create secret generic kis-api-secret \
#     --from-literal=KIS_APP_KEY=... \
#     --from-literal=KIS_APP_SECRET=... \
#     --from-literal=KIS_ACCOUNT_NO=12345678
#
# 실전 전환 시에만 KIS_REAL_CONFIRM=I-UNDERSTAND-THIS-IS-REAL-MONEY 를 추가한다.
# 실전과 모의는 앱키가 다르다. 실전 키를 넣고 KIS_ENV=demo 로 두면 토큰 발급이 실패한다.
apiVersion: v1
kind: Secret
metadata:
  name: kis-api-secret
  namespace: stock-trading
type: Opaque
stringData:
  KIS_APP_KEY: "<모의투자 앱키>"
  KIS_APP_SECRET: "<모의투자 앱시크릿>"
  KIS_ACCOUNT_NO: "<계좌번호 앞 8자리>"
