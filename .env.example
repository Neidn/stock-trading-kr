# ============================================================
# stock-trading-kr — 환경변수 예시. 로컬 실행용.
# k8s 에서는 k8s/configmaps + k8s/secrets 로 같은 값을 넣는다.
# 복사해서 .env 로 쓰고 절대 커밋하지 않는다.
# ============================================================

# ── 한국투자증권 OpenAPI ───────────────────────────────────
# demo(모의투자) | real(실전). 실전은 KIS_REAL_CONFIRM 도 있어야 기동한다.
KIS_ENV=demo
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리 / 뒤 2자리
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT=01
# 초당 호출 한도 (기본: demo 2, real 15 — 공식 샘플 코드에서 추정, 공식 한도 미확인)
# KIS_RPS=2

# ── 비용 ───────────────────────────────────────────────────
# 매매수수료율 (매수·매도 각각). 기본값 없음 — 계좌의 실제 수수료율을 확인해서 넣는다.
FEE_RATE=

# ── 유니버스 · 전략 ────────────────────────────────────────
UNIVERSE=005930,000660
STRATEGIES=ema_crossover
STRATEGY_PARAMS={}
SIGNAL_TIME=09:10

# ── 리스크 ─────────────────────────────────────────────────
RISK_PER_TRADE_KRW=50000
MAX_POSITION_KRW=2000000
MAX_POSITIONS=5
DAILY_LOSS_LIMIT_KRW=200000
MAX_CONSECUTIVE_ERRORS=5
GAP_SCENARIO_PCT=0.10

# ── DB · 알림 ──────────────────────────────────────────────
DATABASE_URL=postgresql://trading:password@localhost:5432/trading
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
